# 北斗命數環境變量配置
# 複製此文件為 .env 並修改

# 服務配置
MINGSHU_PORT=5000
MINGSHU_HOST=0.0.0.0
FLASK_ENV=production

# 安全配置 (務必修改!)
MINGSHU_SECRET_KEY=your-super-secret-key-change-me

# 資料庫配置
MINGSHU_DB_PATH=./data/mingshu.db

# 日誌配置
MINGSHU_LOG_LEVEL=INFO
MINGSHU_LOG_PATH=./logs

# API 配額配置
MINGSHU_BASIC_QUOTA=30
MINGSHU_PRO_QUOTA=-1
MINGSHU_ADVANCED_QUOTA=-1

# 備份配置
MINGSHU_BACKUP_ENABLED=true
MINGSHU_BACKUP_PATH=./backups
MINGSHU_BACKUP_KEEP_DAYS=30
