[Unit]
Description=北斗命數 API 服務
After=network.target

[Service]
Type=simple
User=mingshu
Group=mingshu
WorkingDirectory=/opt/mingshu
Environment=FLASK_ENV=production
Environment=MINGSHU_PORT=5000
ExecStart=/opt/mingshu/venv/bin/gunicorn -w 4 -b 0.0.0.0:5000 mingshu_api_unified_v2:app
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=10

# 安全設置
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/mingshu/data /opt/mingshu/logs

[Install]
WantedBy=multi-user.target
